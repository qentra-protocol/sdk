{
  "name": "@qentra/sdk",
  "version": "0.1.0-dev.0",
  "private": true,
  "type": "module",
  "description": "Qentra Protocol sdk: request records and reproducible application randomness",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "schemas",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.verify.json",
    "test": "tsx --test tests/*.test.ts",
    "example": "tsx examples/request-and-map.ts",
    "check": "npm run typecheck && npm test && npm run example && npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "tsx": "4.20.6",
    "@types/node": "22.18.6"
  },
  "peerDependencies": {
    "@qentra/core": "0.1.0-dev.0"
  }
}
